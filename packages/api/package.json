{
  "name": "@holocron/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./db": {
      "types": "./src/db.ts",
      "default": "./src/db.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.990.0",
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/client-sfn": "^3.990.0",
    "@aws-sdk/lib-dynamodb": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@holocron/core": "workspace:*",
    "hono": "^4.11.9"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "vitest": "^4.0.18"
  }
}
